# ============================================
# VARIABLES DE ENTORNO PARA PRODUCCION (VPS)
# Copiar este archivo y renombrarlo a .env en la raiz del repo
# ============================================

# PostgreSQL (Docker)
POSTGRES_DB=labtronix_db
POSTGRES_USER=labtronix_user
POSTGRES_PASSWORD=GENERAR_PASSWORD_ALEATORIO_AQUI_MIN_32_CHARS

# Redis (Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

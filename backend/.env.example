# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=labtronix_db
DATABASE_USER=labtronix_user
DATABASE_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_SECRET_KEY_LONG_AND_RANDOM_MIN_32_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_AND_RANDOM_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Mantener false en VPS salvo una necesidad explícita y protegida.
ENABLE_SWAGGER=false

# Solo para crear usuarios iniciales con `npm run seed`; no conservar en producción.
# Enable only behind a trusted reverse proxy such as Nginx.
TRUST_PROXY=false

# Configurable local upload limits. The technical ceiling is 250 MB per file.
UPLOAD_MAX_EXCEL_MB=100
UPLOAD_MAX_IMAGE_MB=50

SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_COMERCIAL_PASSWORD=CHANGE_ME
SEED_TECNICO_PASSWORD=CHANGE_ME

# Base de datos
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=labtronix_db
DATABASE_USER=labtronix_user
DATABASE_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=CHANGE_ME_SECRET_KEY_LONG_AND_RANDOM_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_AND_RANDOM_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad - import de usuarios por Excel
# Contraseña temporal con la que se crean los usuarios NUEVOS del import.
# Si no se define, el import de usuarios nuevos falla (fail-closed).
DEFAULT_IMPORT_PASSWORD=CHANGE_ME

# Seguridad - SSO Google: dominios autorizados para auto-registro (separados por coma).
# Vacío = NO se crean cuentas automáticamente vía OAuth.
GOOGLE_ALLOWED_DOMAINS=

# Rate limit global por IP (defensa en profundidad; en VPS el proxy impone el límite distribuido)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# App
PORT=3001
NODE_ENV=development

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Mantener false en VPS salvo una necesidad explícita y protegida.
ENABLE_SWAGGER=false

# Solo para crear usuarios iniciales con `npm run seed`; no conservar en producción.
# Enable only behind a trusted reverse proxy such as Nginx.
TRUST_PROXY=false

# Configurable local upload limits. The technical ceiling is 250 MB per file.
UPLOAD_MAX_EXCEL_MB=100
UPLOAD_MAX_IMAGE_MB=50

SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_COMERCIAL_PASSWORD=CHANGE_ME
SEED_TECNICO_PASSWORD=CHANGE_ME

# ============================================
# BACKEND .env PARA PRODUCCION (VPS)
# Copiar a backend/.env en el VPS
# ============================================

# Base de datos (Docker - red interna)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=labtronix_db
DATABASE_USER=labtronix_user
DATABASE_PASSWORD=GENERAR_PASSWORD_ALEATORIO_AQUI

# JWT - GENERAR SECRETOS ALEATORIOS Y DIFERENTES (min 32 chars)
# Ejemplo: openssl rand -hex 32
JWT_SECRET=GENERAR_SECRET_ALEATORIO_AQUI_MIN_32_CHARS
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=GENERAR_SECRET_ALEATORIO_DIFERENTE_AQUI_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=production

# Frontend URL (CORS) - Cambiar cuando tengas dominio
FRONTEND_URL=http://169.58.235.196

# Swagger - desactivado en produccion
ENABLE_SWAGGER=false

# Trust proxy (Nginx esta en el mismo servidor)
TRUST_PROXY=true

# Upload limits
UPLOAD_MAX_EXCEL_MB=100
UPLOAD_MAX_IMAGE_MB=50

# Seed passwords - USAR UNA SOLA VEZ Y LUEGO ELIMINAR
SEED_ADMIN_PASSWORD=GENERAR_PASSWORD_ALEATORIO_AQUI
SEED_COMERCIAL_PASSWORD=GENERAR_PASSWORD_ALEATORIO_AQUI
SEED_TECNICO_PASSWORD=GENERAR_PASSWORD_ALEATORIO_AQUI

# Cloudinary (tu cuenta actual)
# CLOUDINARY_CLOUD_NAME=tu_cloud_name
# CLOUDINARY_API_KEY=tu_api_key
# CLOUDINARY_API_SECRET=tu_api_secret

# Redis (opcional, para rate limiting futuro)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
